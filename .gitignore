*

# common files between crates and root directory
!.gitignore
!.gitattributes
!justfile
!Cargo.toml
!Cargo.lock
!README.md
!rustfmt.toml
!compose.yaml
!.cargo/
!.cargo/config.toml
!.config/
!.config/nextest.toml
!rust-toolchain.toml
!Dockerfile
!Dockerfile.cd
!.dockerignore
!scripts/
!scripts/docker-build.sh
!scripts/docker-smoke-test.sh
!LICENSE-APACHE
!LICENSE-MIT

# GitHub Actions workflows
!.github/
!.github/workflows/
!.github/workflows/*.yml

# allowlist `crates` directories and their children, regardless of place
!crates/
!crates/**/
!crates/**/*.rs

#allowlist `apps` directories and their children, regardless of place
!apps
!apps/**/
!apps/**/*.rs

!examples/
!examples/example-js-containers/
!examples/example-js-containers/**

# SQL grammar
!crates/**/*.pest

# Release tooling
!release-plz.toml
!CHANGELOG.md
!RELEASING.md
