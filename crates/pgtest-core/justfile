crate := "pgtest-core"

# List available recipes
help:
    @just --list --unsorted --list-prefix '  ' --list-heading $'pgTest Core\n'

# Format this crate
fmt:
    cargo +nightly fmt -p {{crate}}

# Check this crate's formatting without changing files
fmt-check:
    cargo +nightly fmt -p {{crate}} --check

# Run Clippy on all targets in this crate
lint:
    cargo clippy -p {{crate}} --all-targets -- -D warnings

# Run cargo check on this crate
check:
    cargo check -p {{crate}} --all-targets

# Check all targets with profiling enabled
check-profile:
    cargo check -p {{crate}} --all-targets --features hotpath

# Run cargo build on this crate
build:
    cargo build -p {{crate}} --all-targets

# Run shared logic and Tokio driver tests (no Docker)
test:
    cargo test --locked -p {{crate}} --features runtime-tests

# Verify deterministic simulation without Tokio in the dependency graph
test-unit:
    cargo test --locked -p {{crate}} --no-default-features --features test-support

# Test real task scheduling, timers, and cancellation with a controlled backend
test-runtime:
    cargo test --locked -p {{crate}} --features runtime-tests worker_manager::tests

# PostgreSQL-backed runtime and wire tests live at the composition boundary
test-integration:
    cargo test --locked -p pgtest-wire

# Build and open the docs of this crate
doc:
    cargo doc -p {{crate}} --no-deps --open
