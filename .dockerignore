# Send only the workspace inputs needed to compile the server.
**
!Dockerfile
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!.cargo/
!.cargo/config.toml
!scripts/
!scripts/docker-build.sh
!crates/
!crates/**/
!crates/**/Cargo.toml
!crates/**/*.rs
!crates/**/*.pest
!apps/
!apps/**/
!apps/**/Cargo.toml
!apps/**/*.rs
**/target/
**/.git/
